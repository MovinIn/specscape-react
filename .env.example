# Backend the dev server proxies /api to (default: https://specscape.org).
# Point this at a local backend if you have one running.
# VITE_API_PROXY_TARGET=http://localhost:8080

# Serve fake data instead of calling the real API. Off by default —
# when unset, the app talks to the real backend and real login works.
# VITE_USE_MOCK_API=true

# Optional: override the reCAPTCHA site key used by the contact/register forms.
# VITE_RECAPTCHA_SITE_KEY=
