# Backend the dev server proxies /api to (default: https://specscape.org).
# Point this at a local backend if you have one running.
# VITE_API_PROXY_TARGET=http://localhost:8080

# Serve fake data instead of calling the real API. Off by default —
# when unset, the app talks to the real backend and real login works.
# VITE_USE_MOCK_API=true

# Local administrator navigation/UI only; backend permissions remain unchanged.
# Enabled by .env.live for the default 5176 workspace.
# VITE_LOCAL_ADMIN=true

# npm run dev uses .env.live (real data).
# npm run dev:demo explicitly uses .env.preview (sample data, port 5177).

# Optional: override the reCAPTCHA site key used by the contact/register forms.
# VITE_RECAPTCHA_SITE_KEY=

# Public Mapbox token for the sensor map tiles (the pk. token the legacy site uses).
# VITE_MAPBOX_TOKEN=pk....
