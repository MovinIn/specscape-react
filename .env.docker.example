# Copy to .env and adjust. Used by docker-compose.yml.
WEB_PORT=8080
API_UPSTREAM=https://specscape.org
API_HOST=specscape.org
# "/api/" keeps the prefix; use "/" if the backend serves from its root.
API_PATH=/api/
# Local http testing only (lets login cookies work without HTTPS):
# COOKIE_FLAGS=~ nosecure samesite=lax
# Baked into the bundle at build time:
# VITE_RECAPTCHA_SITE_KEY=
# VITE_MAPBOX_TOKEN=
